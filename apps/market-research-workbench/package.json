{
  "name": "@pi/market-research-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop workbench prototype for manufacturing market research",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
